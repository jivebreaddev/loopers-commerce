{
  "uid": "loopers-llm-serving",
  "title": "Loopers LLM Serving",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "tags": [
    "llm",
    "vllm",
    "gateway"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Model / gateway availability",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"llm-gateway|vllm-primary|vllm-fallback\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Gateway active / waiting requests",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_gateway_active",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "llm_gateway_waiting",
          "legendFormat": "waiting"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Gateway request outcomes / sec",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(llm_gateway_requests_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Gateway latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_gateway_request_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Backend routing outcomes / sec",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (backend, outcome) (rate(llm_gateway_backend_attempts_total[1m]))",
          "legendFormat": "{{backend}} {{outcome}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Circuit state (1 = open / probing)",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_gateway_circuit_open",
          "legendFormat": "{{backend}}"
        }
      ],
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Settled token throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(llm_gateway_tokens_total[1m]))",
          "legendFormat": "{{kind}} tokens/s"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Global budget (USD, current UTC month)",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_gateway_budget_available_micro_usd / 1000000",
          "legendFormat": "available"
        },
        {
          "refId": "B",
          "expr": "llm_gateway_budget_committed_micro_usd / 1000000",
          "legendFormat": "charged + reserved"
        }
      ],
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "vLLM KV cache utilization",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vllm:kv_cache_usage_perc",
          "legendFormat": "{{job}} / engine {{engine}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "vLLM prefix cache hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(vllm:prefix_cache_hits_total[5m])) / clamp_min(sum by (job) (rate(vllm:prefix_cache_queries_total[5m])), 0.000001)",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "vLLM engine queue / running",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vllm:num_requests_running",
          "legendFormat": "{{job}} running / {{engine}}"
        },
        {
          "refId": "B",
          "expr": "vllm:num_requests_waiting",
          "legendFormat": "{{job}} waiting / {{engine}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "vLLM time to first token p95",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "vLLM preemptions / sec",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(vllm:num_preemptions_total[5m]))",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Settled charges since gateway start (USD)",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_gateway_charged_micro_usd_total / 1000000",
          "legendFormat": "charges"
        }
      ],
      "options": {}
    },
    {
      "id": 15,
      "title": "Fallback decisions / sec",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason, backend) (rate(llm_gateway_fallbacks_total[1m]))",
          "legendFormat": "{{reason}} / {{backend}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 16,
      "title": "Department available budget (USD)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_gateway_department_available_micro_usd / 1000000",
          "legendFormat": "{{department}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 17,
      "title": "Observed backend availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_gateway_backend_ready",
          "legendFormat": "{{backend}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 18,
      "title": "Observed backend waiting requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "llm-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_gateway_engine_waiting",
          "legendFormat": "{{backend}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
