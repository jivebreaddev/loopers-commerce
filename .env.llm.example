# Copy to .env at the repository root. The gateway refuses to start without accounts.
LLM_ACCOUNTS=[{"name":"local-demo","api_key":"replace-with-a-long-local-key","monthly_budget_micro_usd":10000000}]
LLM_MODEL=local-model
LLM_PRIMARY_MODEL=local-primary
LLM_PRIMARY_URL=http://127.0.0.1:8001
LLM_PRIMARY_API_KEY=local-vllm-primary
# Set http://127.0.0.1:8002 for host mode or http://vllm-fallback:8000 for Docker mode.
# LLM_FALLBACK_URL=http://127.0.0.1:8002
LLM_FALLBACK_API_KEY=local-vllm-fallback
LLM_FALLBACK_MODEL=local-small
LLM_FALLBACK_FREE=true
# Engine metrics are polled independently of the gateway queue. 0 disables polling.
LLM_HEALTH_POLL_INTERVAL_SECONDS=5
LLM_BACKEND_MAX_QUEUE=10
# Optional JSON maps / lists
LLM_DEPARTMENT_BUDGETS={}
LLM_CORS_ORIGINS=[]
# For an arbitrary chain, set LLM_BACKENDS instead of primary/fallback variables.
# LLM_BACKENDS=[{"name":"primary","url":"http://127.0.0.1:8001","model":"local-primary","api_key":"local-vllm-primary","priority":0,"input_price":2,"output_price":6,"max_queue":10},{"name":"small","url":"http://127.0.0.1:8002","model":"local-small","api_key":"local-vllm-fallback","priority":1,"input_price":0,"output_price":0,"max_queue":10}]
# Optional sticky canary allocation (backend name, ratio 0..1)
# LLM_CANARY_BACKEND=fallback
LLM_CANARY_RATIO=0
LLM_CONTEXT_LIMIT=4096
LLM_MAX_OUTPUT_TOKENS=1024
LLM_CONCURRENCY=4
LLM_QUEUE_SIZE=16
LLM_QUEUE_WAIT_SECONDS=5
LLM_UPSTREAM_TIMEOUT_SECONDS=60
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RECOVERY_SECONDS=15
LLM_GLOBAL_MONTHLY_BUDGET_MICRO_USD=20000000
# Example tariff only. $2 / million input tokens, $6 / million output tokens.
LLM_INPUT_MICRO_USD_PER_TOKEN=2
LLM_OUTPUT_MICRO_USD_PER_TOKEN=6
LLM_LEDGER_PATH=./data/llm-billing.sqlite3

# Docker vLLM configuration (Linux + NVIDIA GPU + NVIDIA Container Toolkit).
VLLM_IMAGE=vllm/vllm-openai:v0.11.2
VLLM_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
VLLM_FALLBACK_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
# To use local weights: VLLM_MODEL_DIR=/absolute/host/models and VLLM_MODEL_ID=/models/model
VLLM_MODEL_DIR=../models
VLLM_PRIMARY_GPU_ID=0
VLLM_FALLBACK_GPU_ID=1
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_FALLBACK_GPU_MEMORY_UTILIZATION=0.85
VLLM_KV_CACHE_DTYPE=auto
VLLM_BLOCK_SIZE=16
VLLM_MAX_NUM_SEQS=8
VLLM_MAX_NUM_BATCHED_TOKENS=4096
GRAFANA_ADMIN_PASSWORD=local-grafana-password
